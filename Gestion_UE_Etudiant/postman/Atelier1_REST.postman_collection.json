{
  "info": {
    "name": "Ateliers REST 1 et 5 - Gestion UE / Modules",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Atelier 1 : CRUD des UE et des modules. Atelier 5 : sécurité par jeton JWT (POST, PUT et DELETE exigent le jeton). Variables : baseUrl, token."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/Gestion_UE_VF_war_exploded/rest"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Authentification",
      "item": [
        {
          "name": "1. Obtenir un jeton - formulaire (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.text()); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "ines",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "1234",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/authentication",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication"
              ]
            },
            "description": "Le jeton reçu est enregistré automatiquement dans la variable token."
          }
        },
        {
          "name": "2. Obtenir un jeton - JSON (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.text()); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Mariem\",\n  \"password\": \"mariem\"\n}",
              "options": {
