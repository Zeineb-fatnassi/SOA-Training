            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{\n  getallmodules {\n    matricule\n    nom\n    coefficient\n    volumeHoraire\n    type\n    uniteEnseignement {\n      code\n      domaine\n    }\n  }\n}",
                "variables": ""
