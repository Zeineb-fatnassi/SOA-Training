                "query": "{\n  modules: getallmodules {\n    matricule\n    nom\n  }\n  semestre1: getUniteEnseignementsBySemestre(semestre: 1) {\n    code\n    domaine\n  }\n  semestre2: getUniteEnseignementsBySemestre(semestre: 2) {\n    code\n    domaine\n  }\n  ue: getUniteEnseignementByCode(code: 1) {\n    responsable\n  }\n}",
